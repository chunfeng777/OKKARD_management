{
  "name": "ok-card-empire-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "vue-tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-i18n": "11.1.2",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.24.0",
    "vite": "6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "2.2.0"
  }
}
